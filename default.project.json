{
  "name": "Spark2D",
  "globIgnorePaths": ["**/wally.toml", "**/Packages"],
  "tree": {
    "$path": "src",

    "Cleaner": {
      "$path": { "optional": "build/deps/Cleaner.luau" }
    },
    "Signal": {
      "$path": { "optional": "build/deps/Signal.luau" }
    },
    "Pool": {
      "$path": { "optional": "build/deps/Pool.luau" }
    }
  }
}
